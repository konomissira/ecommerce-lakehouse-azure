# Copy to .env and fill in. Never commit .env.

# Databricks (feature/02). The CLI stores your login in ~/.databrickscfg.
LAKEHOUSE_CATALOG=ecommerce

# dbt (feature/04). Not secrets: the token is fetched at run time.
# Host without https://, and the SQL warehouse's HTTP path from its
# Connection details tab.
DBT_DATABRICKS_HOST=
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/

# Azure (from feature/06)
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=uksouth
