# Copy to .env and fill in. Never commit .env.

# Databricks (feature/02). The CLI stores your login in ~/.databrickscfg.
LAKEHOUSE_CATALOG=ecommerce

# dbt (feature/04). Not secrets: the token is fetched at run time.
# Host without https://, and the SQL warehouse's HTTP path from its
# Connection details tab.
DBT_DATABRICKS_HOST=
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/

# The Databricks job (feature/05): the same warehouse's ID, the last part of the
# HTTP path above.
BUNDLE_VAR_warehouse_id=

# Azure (feature/06). Terraform reads these two; neither is a password, but
# keep them out of git and screenshots.
ARM_SUBSCRIPTION_ID=
TF_VAR_budget_email=
